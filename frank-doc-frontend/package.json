    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@frankframework/angular-components": "^1.4.3",
    "@frankframework/doc-library-core": "^1.0.4",
    "@frankframework/doc-library-ng": "^1.0.4",
    "fuse.js": "^7.4.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
